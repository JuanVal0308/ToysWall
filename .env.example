# Supabase Configuration (REPLACE WITH YOUR VALUES)
# For static HTML/JS apps without build step:
#
# Option 1 (Recommended for local development):
# Copy js/config.example.js to js/config.local.js and fill in your credentials
# config.local.js is gitignored and won't be committed
#
# Option 2 (For production with hosting providers like Netlify/Vercel):
# Configure environment variables in your hosting dashboard
# They will be injected as window.ENV at build time
#
# Note: The Supabase ANON_KEY is designed to be public (it's safe in frontend code)
# RLS policies protect your data. NEVER expose the SERVICE_ROLE_KEY in frontend!

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# EmailJS Configuration (Optional - for sending invoices by email)
EMAILJS_SERVICE_ID=your-service-id
EMAILJS_TEMPLATE_ID=your-template-id
EMAILJS_PUBLIC_KEY=your-public-key

# Email Settings
FROM_EMAIL=toyswalls@gmail.com
FROM_NAME=ToysWalls
